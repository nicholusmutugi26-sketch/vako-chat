# Shared backend template. Use the same backend codebase for both nodes.
# Node 1: SERVER_ID=node-1, PORT=8001
# Node 2: SERVER_ID=node-2, PORT=8002
SERVER_ID=node-1
HOST=0.0.0.0
PORT=8001
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:5173
APP_SECRET_KEY=replace-with-a-long-random-development-secret
DATABASE_URL=sqlite:///./vakochat.db
LOG_LEVEL=INFO
